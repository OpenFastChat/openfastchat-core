#!/bin/bash
# SPDX-FileCopyrightText: 2026 Bart van de Lint <bart@vandelint.net>
# SPDX-License-Identifier: AGPL-3.0-only

set -euo pipefail

dry_run=false
assume_yes=false
sha=""
target=""

print_usage() {
    echo "Usage:"
    echo "  ./scripts/release go         Release the Go module (tag vX.Y.Z)"
    echo "  ./scripts/release ui         Release @openfastchat/ui (tag ui-vX.Y.Z)"
    echo
    echo "  --dry-run   Print the version, commit and notes, then exit"
    echo "  --yes       Skip the confirmation prompt"
    echo "  --sha SHA   Release a specific commit instead of HEAD"
    echo "  -h"
    echo
    echo "The Go module and @openfastchat/ui version independently. Each release"
    echo "reads the top versioned section of its own changelog (CHANGELOG.md for"
    echo "go, frontend/CHANGELOG.md for ui) and cuts a GitHub release whose body is"
    echo "those notes plus GitHub's auto-generated merged-PR list. Publishing the"
    echo "release fires the matching workflow (release-go.yml or publish-ui.yml),"
    echo "which is guarded by the tag prefix. The commit must be pushed."
    echo "See COMPATIBILITY.md for which versions work together."
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        go|ui) target="$1"; shift ;;
        -h|--help) print_usage; exit 0 ;;
        -n|--dry-run) dry_run=true; shift ;;
        -y|--yes) assume_yes=true; shift ;;
        --sha) sha="${2:?--sha needs an argument}"; shift 2 ;;
        *) echo "Unknown option: $1" >&2; print_usage >&2; exit 1 ;;
    esac
done

if [[ -z "$target" ]]; then
    echo "Pick a target: go or ui." >&2
    print_usage >&2
    exit 1
fi

if [[ $(basename "$(pwd)") == "scripts" ]]; then
    cd ..
fi

for cmd in git gh awk; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "Required command not found: $cmd" >&2
        exit 1
    fi
done

if ! gh auth status >/dev/null 2>&1; then
    echo "gh is not authenticated. Run 'gh auth login' first." >&2
    exit 1
fi

# Prints the latest versioned tag from a changelog, skipping [Unreleased].
latest_version() {
    awk '
        /^## / {
            line = $0
            sub(/^## /, "", line)
            gsub(/[][]/, "", line)
            split(line, parts, " ")
            v = parts[1]
            if (tolower(v) == "unreleased") next
            if (v ~ /^v?[0-9]/) { print v; exit }
        }
    ' "$1"
}

# Prints the body of the latest versioned section, trimming blank edge lines.
latest_notes() {
    awk '
        /^## / {
            line = $0; sub(/^## /, "", line); gsub(/[][]/, "", line)
            split(line, parts, " ")
            if (tolower(parts[1]) == "unreleased") next
            seen++
            if (seen == 1) next
            if (seen >= 2) exit
        }
        seen == 1 { print }
    ' "$1" | awk '
        { lines[NR] = $0 }
        END {
            start = 1
            while (start <= NR && lines[start] ~ /^[[:space:]]*$/) start++
            end = NR
            while (end >= start && lines[end] ~ /^[[:space:]]*$/) end--
            for (i = start; i <= end; i++) print lines[i]
        }
    '
}

if [[ "$target" == go ]]; then
    changelog="CHANGELOG.md"
    label="openfastchat-core (Go module)"
    tag_prefix=""
else
    changelog="frontend/CHANGELOG.md"
    label="@openfastchat/ui (npm)"
    tag_prefix="ui-"
fi

version=$(latest_version "$changelog")
if [[ -z "$version" ]]; then
    echo "No versioned section found in $changelog" >&2
    exit 1
fi
[[ "$version" == v* ]] || version="v$version"

notes=$(latest_notes "$changelog")
if [[ -z "$notes" ]]; then
    echo "No release notes found under the $version section of $changelog." >&2
    exit 1
fi

tag="${tag_prefix}${version}"

if [[ -z "$sha" ]]; then
    sha=$(git rev-parse HEAD)
fi

if [[ -n "$(git status --porcelain)" ]]; then
    echo "Warning: working tree has uncommitted changes." >&2
fi

repo=$(gh repo view --json nameWithOwner -q .nameWithOwner)

if ! gh api "repos/$repo/commits/$sha" >/dev/null 2>&1; then
    echo "Commit $sha was not found on $repo. Push it first:" >&2
    echo "  git push" >&2
    exit 1
fi

if gh release view "$tag" --repo "$repo" >/dev/null 2>&1; then
    echo "Release $tag already exists on $repo." >&2
    exit 1
fi

echo "Repository:   $repo"
echo "Artifact:     $label"
echo "Version:      $version"
echo "Tag:          $tag"
echo "Commit:       $sha"
echo
echo "Release notes:"
echo "--------------------------------------------------------------------------"
echo "$notes"
echo "--------------------------------------------------------------------------"
echo "(GitHub appends the merged-PR list since the previous release below this.)"

if [[ "$dry_run" == true ]]; then
    echo
    echo "Dry run: no release created."
    exit 0
fi

if [[ "$assume_yes" != true ]]; then
    echo
    read -r -p "Create and publish this release? [y/N] " reply
    if [[ ! "$reply" =~ ^[Yy]$ ]]; then
        echo "Aborted."
        exit 1
    fi
fi

url=$(gh api "repos/$repo/releases" \
    -f tag_name="$tag" \
    -f target_commitish="$sha" \
    -f name="$tag" \
    -f body="$notes" \
    -F generate_release_notes=true \
    -q .html_url)

echo
echo "Published: $url"
if [[ "$target" == go ]]; then
    echo "release-go.yml will verify $tag."
else
    echo "publish-ui.yml will publish @openfastchat/ui $version."
fi
